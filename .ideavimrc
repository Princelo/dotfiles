source ~/.virc
nmap gi :action GotoImplementation<CR>
nmap gr :action FindUsages<CR>
nmap gy :action GotoTypeDeclaration<CR>
nmap gp :action GotoSuperMethod<CR>
nmap <leader>rn :action RenameElement<CR>
nmap <leader>o :action FileStructurePopup<CR>
nmap <leader>h :action TypeHierarchy<CR>
nmap <leader>tm :action ActivateTerminalToolWindow<CR>
nmap <leader>/ :action FindInPath<CR>
vmap <leader>/ :action FindInPath<CR>
nmap <leader>f :action GotoFile<CR>
nmap <leader>t :action GotoSymbol<CR>
vmap <leader>t :action GotoSymbol<CR>
vmap <leader>l :action ReformatCode<CR>
nmap <leader>b :action RecentFiles<CR>
nmap <leader>ca :action ShowIntentionActions<CR>
set ideajoin
set NERDTree
nmap <leader>e :NERDTree<CR>
nmap ]b :action <Action>(NextTab)
nmap [b :action <Action>(PreviousTab)
nnoremap ]d :action GotoNextError<CR>
nnoremap [d :action GotoPreviousError<CR>
let g:qs_highlight_on_keys = ['f', 'F', 't', 'T']
let g:qs_primary_color = '#afff5f'
let g:qs_secondary_color = '#5fffff'
set quickscope
nnoremap zj j/{\s*$<CR>:noh<CR>0
nnoremap zk ?}\s*$<CR>:noh<CR>k
nnoremap gcc :action CommentByLineComment<CR>
nnoremap <leader>c :action CommentByLineComment<CR>
vnoremap gc :action CommentByLineComment<CR>
vnoremap <leader>c :action CommentByLineComment<CR>
nnoremap gbc :action CommentByBlockComment<CR>
nnoremap <leader>C :action CommentByBlockComment<CR>
vnoremap gb :action CommentByBlockComment<CR>
vnoremap <leader>C :action CommentByBlockComment<CR>
